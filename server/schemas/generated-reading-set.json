{
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["section", "domain", "skillId", "difficulty", "stimulus", "prompt", "choices", "answer", "explanation", "concept", "estimatedSeconds"],
        "properties": {
          "section": { "type": "string", "enum": ["rw"] },
          "domain": { "type": "string", "enum": ["craft-structure", "information-ideas", "standard-english", "expression-ideas"] },
          "skillId": { "type": "string", "enum": ["words-in-context", "text-structure-purpose", "cross-text-connections", "central-ideas-details", "command-evidence-textual", "command-evidence-quantitative", "inferences", "boundaries", "form-structure-sense", "rhetorical-synthesis", "transitions"] },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "stimulus": { "type": "string" },
          "secondaryStimulus": { "type": "string" },
          "prompt": { "type": "string" },
          "table": {
            "type": "object",
            "required": ["caption", "headers", "rows"],
            "properties": {
              "caption": { "type": "string" },
              "headers": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } },
              "rows": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } } }
            }
          },
          "choices": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "enum": ["A", "B", "C", "D"] },
                "text": { "type": "string" }
              }
            }
          },
          "answer": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "explanation": { "type": "string" },
          "concept": { "type": "string" },
          "whyWrong": { "type": "object" },
          "misconceptionByChoice": { "type": "object" },
          "estimatedSeconds": { "type": "integer", "minimum": 30, "maximum": 150 }
        }
      }
    }
  }
}
