{
  "type": "object",
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["index", "verdict", "solvedAnswer", "uniqueAnswer", "reason"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 11 },
          "verdict": { "type": "string", "enum": ["accept", "reject"] },
          "solvedAnswer": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "uniqueAnswer": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
